{
  "$schema": "../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "dataGroups": [
    {
      "name": "chatbot-api",
      "urls": [
        "https://*.workers.dev/**",
        "https://api.arecofix.com.ar/**",
        "https://worker.arecofix.com.ar/**",
        "https://arecofix.com.ar/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "0u",
        "timeout": "3s"
      }
    },
    {
      "name": "external-apis",
      "urls": [
        "https://db.arecofix.com.ar/**",
        "https://*.supabase.co/**",
        "https://static.cloudflareinsights.com/**",
        "https://us.i.posthog.com/**",
        "https://*.posthog.com/**",
        "https://connect.facebook.net/**",
        "https://www.googletagmanager.com/**",
        "https://analytics.google.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "5s"
      }
    }
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ]
}
