# ==============================================================================
# ARECOFIX - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo a '.env' para desarrollo local o en el servidor VPS:
#    cp .env.example .env
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. NUNCA subas '.env' a un repositorio público (está protegido en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# URL del endpoint self-hosted en la VPS (o Supabase Cloud si aplica)
# Nota: La arquitectura actual de Arecofix utiliza la instancia propia en Oracle VPS.
SUPABASE_URL=https://db.arecofix.com.ar
SUPABASE_DATA_URL=https://db.arecofix.com.ar

# Anon Public Key (Protegida por RLS a nivel de base de datos)
SUPABASE_ANON_KEY=your-anon-jwt-token-here

# Service Role Key (Solo para scripts administrativos del backend/migraciones; NUNCA exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Conexión directa PostgreSQL (para migraciones / poolers)
DATABASE_URL=postgresql://postgres:your_password@db.arecofix.com.ar:5432/postgres

# ------------------------------------------------------------------------------
# 2. APLICACIÓN Y SERVIDOR NODE.JS (SSR)
# ------------------------------------------------------------------------------
APP_NAME=Arecofix
NODE_ENV=production
PORT=4000
API_URL=https://arecofix.com.ar
BASE_URL=https://arecofix.com.ar
AUTH_REDIRECT_URL=https://arecofix.com.ar
ENABLE_PROFILE_UPSERT=false

# Backend Flask local (Soporte offline / Tauri)
FLASK_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 3. ANALYTICS & MONITORING (PostHog)
# ------------------------------------------------------------------------------
POSTHOG_KEY=phc_your_posthog_project_key_here
POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 4. META & WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-waba-id
WHATSAPP_APP_ID=your-meta-app-id
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
META_MARKETING_TOKEN=your-marketing-api-token
WHATSAPP_API_URL=https://graph.facebook.com/v22.0

# ------------------------------------------------------------------------------
# 5. RAG AI CHATBOT & EMBEDDINGS WORKER (Cloudflare Workers)
# ------------------------------------------------------------------------------
CHATBOT_WORKER_URL=https://arecofix-rag-chatbot.ezequielenrico15.workers.dev
EMBEDDING_WORKER_URL=https://arecofix-embedding-ingestion.ezequielenrico15.workers.dev
CHATBOT_SECRET=your-hmac-sha256-worker-secret

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DE DESPLIEGUE SSH / VPS AUTOMATIZADO
# ------------------------------------------------------------------------------
# Parámetros utilizados por los scripts de despliegue (pnpm run deploy)
DEPLOY_SSH_HOST=ssh.arecofix.com.ar
DEPLOY_SSH_USER=ubuntu
DEPLOY_SSH_KEY=ssh-key-2026-08-30.key
DEPLOY_REMOTE_DIR=/home/ubuntu/arecofix
DEPLOY_PM2_APP=arecofix-frontend

# ------------------------------------------------------------------------------
# 7. MERCADO PAGO INTEGRATION
# ------------------------------------------------------------------------------
# Access token privado (Sandbox o Producción). NUNCA exponer en frontend.
MP_ACCESS_TOKEN=APP_USR-your-mercadopago-access-token-here
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-mercadopago-access-token-here

# Public Key para SDK de Mercado Pago / Checkout Bricks
MP_PUBLIC_KEY=APP_USR-your-mercadopago-public-key-here
MERCADOPAGO_PUBLIC_KEY=APP_USR-your-mercadopago-public-key-here

# Webhook secret para validación de firma IPN
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# ------------------------------------------------------------------------------
# 8. EMAIL DELIVERY & TRANSACTIONAL NOTIFICATIONS (Resend / SendGrid)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Arecofix Academy <no-reply@arecofix.com.ar>"

# ------------------------------------------------------------------------------
# 9. SERVICES LANDINGS, LEADS & SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
SITE_URL=https://arecofix.com.ar
WHATSAPP_NUMBER=5491125960900
TURNSTILE_KEY=your_cloudflare_turnstile_site_key_here
TURNSTILE_SECRET=your_cloudflare_turnstile_secret_key_here
LEAD_NOTIFICATION_EMAIL=ezequiel@arecofix.com.ar
IP_HASH_SALT=arecofix-lead-salt-change-in-production-secure-random-bytes
