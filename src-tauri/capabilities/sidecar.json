{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sidecar-capability",
  "description": "Allows executing the backend sidecar",
  "windows": [
    "main"
  ],
  "permissions": [
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "arecofix-backend",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "arecofix-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
