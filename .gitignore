# ==============================================================================
# ARECOFIX - OFFICIAL GITIGNORE CONFIGURATION
# ==============================================================================
# Comprehensive ignore rules for Angular 21, SSR Node.js, Cloudflare, Tauri,
# Capacitor, Jest, Cypress, and SSH/VPS deployment artifacts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO, SECRETOS Y CLAVES CRIPTOGRÁFICAS (CRÍTICO DE SEGURIDAD)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.production
.env.development
!.env.example
src/environments/environment.generated.ts

# Claves privadas SSH, certificados SSL y tokens
*.key
*.pem
*.ppk
*.pub
id_rsa
id_ecdsa
id_ed25519
ssh-key*
*.p12
*.pfx

# ------------------------------------------------------------------------------
# 2. DEPENDENCIAS DE PAQUETES
# ------------------------------------------------------------------------------
node_modules/
.npm
.yarn-integrity
.pnpm-debug.log*
package-lock.json
yarn.lock

# ------------------------------------------------------------------------------
# 3. COMPILACIÓN, BUILDS Y ARTEFACTOS GENERADOS
# ------------------------------------------------------------------------------
dist/
dist.tar.gz
dist_backup/
backups/
*.bak*
deploy-temp/
releases/
build/
bin/
out-tsc/
www/

# Binarios y empaquetados
*.apk
*.aab
*.exe
*.jar
*.rar
*.zip
*.tar.gz
*.tgz

# ------------------------------------------------------------------------------
# 4. FRAMEWORKS: ANGULAR, SSR Y COMPILADORES
# ------------------------------------------------------------------------------
.angular/
.angular/cache/

# ------------------------------------------------------------------------------
# 5. MOBILE & DESKTOP (CAPACITOR & TAURI)
# ------------------------------------------------------------------------------
# Capacitor (Android)
android/app/build/
android/.gradle/
android/capacitor-cordova-android-plugins/build/
android/local.properties

# Tauri Desktop (Rust)
src-tauri/target/
src-tauri/Cargo.lock

# ------------------------------------------------------------------------------
# 6. TESTING, COBERTURA Y REPORTES (JEST & CYPRESS)
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
lib-cov/
test-results/
playwright-report/
playwright/.cache/
playwright/.auth/

# Cypress
cypress/screenshots/
cypress/videos/
cypress/downloads/
cypress/reports/
cypress.env.json
!cypress.env.json.example

# Auditorías Lighthouse
.unlighthouse/
unlighthouse-report/

# ------------------------------------------------------------------------------
# 7. LOGS Y PROCESOS DE SERVICIO (PM2)
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 8. BACKEND & CLOUD SERVICES
# ------------------------------------------------------------------------------
# Supabase Local Cache
supabase/.temp/

# Cloudflare Wrangler Cache
.wrangler/

# Python Cache (Flask offline backend)
__pycache__/
*.py[cod]
*$py.class
Back-End/__pycache__/
Back-End/venv/
.venv/

# ------------------------------------------------------------------------------
# 9. EDITORES, IDES Y SISTEMAS OPERATIVOS
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 10. SCRIPTS TEMPORALES Y SCRATCH
# ------------------------------------------------------------------------------
scratch/
scratch_chatbot/
.agent/
test-*.js
send_test.js
debug.mjs
temp.html
temp.mjs
temp_size.js

# ------------------------------------------------------------------------------
# 11. AUDITORÍAS DE SEGURIDAD LOCALES (REPORTS, POCs, FINDINGS)
# ------------------------------------------------------------------------------
.audit/
