{
  "name": "arecofix",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node -e \"require('fs').rmSync('.angular',{recursive:true,force:true})\" && ng serve",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:e2e": "cypress run --spec 'cypress/e2e/ui/**/*.cy.js'",
    "cypress:open": "cypress open",
    "test:load": "k6 run load-test.js",
    "generate-sitemap": "node scripts/sync-seo.mjs",
    "routes:update": "node scripts/sync-seo.mjs",
    "deploy": "npm run firebase:deploy",
    "firebase:build": "npm run routes:update && npm run build && node scripts/remove-preloads.mjs",
    "firebase:deploy": "npm run firebase:build && firebase deploy --only hosting",
    "firebase:serve": "firebase serve --only hosting",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "overrides": {
    "@angular/animations": "21.2.14",
