{
  "name": "arecofix",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node -e \"require('fs').rmSync('.angular',{recursive:true,force:true})\" && ng serve --host 127.0.0.1",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --configuration production",
    "build:cloudflare": "ng build --configuration cloudflare && node -e \"const fs=require('fs'),path=require('path');function clean(d){fs.readdirSync(d).forEach(f=>{const p=path.join(d,f);const s=fs.statSync(p);if(s.isDirectory())clean(p);else if(s.size>25*1024*1024){fs.unlinkSync(p);console.log('CF: removed oversized file: '+p);}});}clean('dist/arecofix/browser');\"",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "start-server-and-test start http://127.0.0.1:4200 \"cypress run --spec 'cypress/e2e/api/**/*.cy.{js,ts}'\"",
    "test:e2e": "start-server-and-test start http://127.0.0.1:4200 \"cypress run --spec 'cypress/e2e/ui/**/*.cy.{js,ts}'\"",
    "cypress:open": "start-server-and-test start http://127.0.0.1:4200 \"cypress open\"",
    "test:load": "k6 run load-test.js",
    "generate-sitemap": "node scripts/sync-seo.mjs",
    "routes:update": "node scripts/sync-seo.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "overrides": {
    "gh-pages": "^6.3.0",
    "trim-newlines": "^3.0.1",
    "uglify-js": "^3.19.3",
    "ajv": "^8.17.2",
    "minimatch": "^10.2.2",
    "protobufjs": "^7.5.8",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.20.1",
    "qs": "^6.15.2",
    "uuid": "^11.1.1",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "google-auth-library": {
      "gaxios": {
        "uuid": "^11.1.1"
      }
    }
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.3",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "22.1.3",
    "@angular/service-worker": "22.1.3",
    "@angular/ssr": "22.1.5",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-sql": "~2.4.0",
    "chart.js": "4.5.1",
    "dexie": "^4.4.5",
    "express": "^5.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "ng2-charts": "10.0.0",
    "node-fetch": "^2.7.0",
    "posthog-js": "^1.418.10",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "ws": "^8.21.3",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.5",
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.3",
    "@angular/platform-browser-dynamic": "22.1.3",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/k6": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.21.0",
    "daisyui": "^5.7.20",
    "eslint": "^10.9.0",
    "eslint-plugin-cypress": "^7.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^17.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "url": "^0.11.4",
    "wrangler": "^4.125.0"
  }
}
