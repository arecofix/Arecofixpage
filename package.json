{
  "name": "arecofix",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "node -e \"require('fs').rmSync('.angular',{recursive:true,force:true})\" && ng serve --host 127.0.0.1",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.{js,ts}'",
    "test:e2e": "start-server-and-test start http://127.0.0.1:4200 \"cypress run --spec 'cypress/e2e/ui/**/*.cy.{js,ts}'\"",
    "cypress:open": "start-server-and-test start http://127.0.0.1:4200 \"cypress open\"",
    "test:load": "k6 run load-test.js",
    "generate-sitemap": "node scripts/sync-seo.mjs",
    "routes:update": "node scripts/sync-seo.mjs",
    "deploy": "npm run firebase:deploy",
    "firebase:build": "npm run routes:update && npm run build && node scripts/remove-preloads.mjs",
    "firebase:deploy": "npm run firebase:build && firebase deploy --only hosting",
    "firebase:serve": "firebase serve --only hosting",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "overrides": {
    "@angular/animations": "21.2.14",
    "@angular/common": "21.2.14",
    "@angular/compiler": "21.2.14",
    "@angular/core": "21.2.14",
    "@angular/forms": "21.2.14",
    "@angular/platform-browser": "21.2.14",
    "@angular/platform-server": "21.2.14",
    "@angular/router": "21.2.14",
    "@angular/ssr": "21.2.12",
    "@angular/build": "21.2.12",
    "@angular/cli": "21.2.12",
