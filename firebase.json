{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": [
    {
      "target": "areco-fix",
      "public": "dist/arecofix/browser",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**/*.php",
          "destination": "/404",
          "type": 404
        },
        {
          "source": "**/*.cgi",
          "destination": "/404",
          "type": 404
        },
        {
          "source": "/wp-admin/**",
          "destination": "/404",
          "type": 404
        },
        {
          "source": "/wp-includes/**",
          "destination": "/404",
          "type": 404
        },
        {
          "source": "/.well-known/**",
          "destination": "/404",
          "type": 404
        },
        {
          "source": "/xmlrpc.php",
          "destination": "/404",
          "type": 404
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "sitemap.xml",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|gif|webp|svg|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ]
}
